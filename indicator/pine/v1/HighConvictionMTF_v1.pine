//@version=6
indicator("High-Conviction MTF Trend Signals", shorttitle = "HC-MTF", overlay = true, max_labels_count = 500, max_lines_count = 100)

// ─────────────────────────────────────────────────────────────────────────────
// What this does
//   A signal needs a STRUCTURE BREAK: a closed candle beyond the latest confirmed swing
//   high/low. Breaks with the prevailing structure are CONTINUATIONS, breaks against it
//   are REVERSALS. Each break is scored on up to six independent conditions:
//     N  near higher timeframe trend agrees      (4H on 1H, D on 4H, W on D, M on W)
//     A  anchor higher timeframe trend agrees    (D on 1H, W on 4H, M on D, 3M on W)
//     M  momentum: RSI(14) vs 50 and MACD histogram vs 0 agree
//     S  strength: ADX(14) >= 20 with the signal side's DI on top
//     D  displacement: break candle body >= 0.5 ATR(14)
//     V  volume >= 1.3x its 20-bar average (skipped where volume is not meaningful)
//   Score = conditions met / conditions available. CONFIRMED needs score >= confirm,
//   MAJOR also needs score >= major AND the anchor timeframe agreeing. Anything less is
//   no signal: the script is allowed to say nothing.
//   Early WARNINGS (small "!") flag momentum turning against structure before a break.
//
// Integrity
//   * Signals are evaluated on CLOSED candles (barstate.isconfirmed) unless you switch
//     that off; provisional intrabar signals are drawn hollow and may disappear.
//   * Higher-timeframe values come from the previous COMPLETED HTF candle:
//     request.security(..., f()[1], lookahead = barmerge.lookahead_on). This is the
//     documented non-repainting form; history and realtime see the same values.
//   * Swing points are only used once their right-hand bars have closed.
//   * Every rule here is mirrored in the Python research package (hcmtf/signals.py),
//     where it is walk-forward tested. The thresholds below came from that test.
// ─────────────────────────────────────────────────────────────────────────────

// <<VALIDATED (generated by scripts/sync_pine.py from reports/results.json — do not edit by hand)
VAL_CONFIRM_1H = 0.8
VAL_MAJOR_1H   = 1.0
VAL_CONFIRM_4H = 0.8
VAL_MAJOR_4H   = 1.0
VAL_CONFIRM_1D = 0.67
VAL_MAJOR_1D   = 0.8
VAL_CONFIRM_1W = 0.6
VAL_MAJOR_1W   = 0.8
VAL_TEXT_1H = "MAJOR PROMISING · OOS n=2849, hit 33% vs 32% random, +0.19 ATR vs -0.13 random; holdout -0.25 vs -0.19"
VAL_TEXT_4H = "MAJOR PROMISING · OOS n=706, hit 37% vs 34% random, +0.58 ATR vs +0.26 random; holdout +0.46 vs +0.15"
VAL_TEXT_1D = "MAJOR UNPROVEN · OOS n=1461, hit 34% vs 35% random, +0.41 ATR vs +0.40 random; holdout +0.23 vs +0.48"
VAL_TEXT_1W = "MAJOR UNPROVEN · OOS n=135, hit 30% vs 35% random, +0.78 ATR vs +0.76 random; holdout +0.45 vs +1.00"
// VALIDATED>>

// ── inputs ───────────────────────────────────────────────────────────────────
G1 = "Profile"
profileIn  = input.string("Auto", "Timeframe profile", options = ["Auto", "1H", "4H", "1D", "1W"], group = G1,
     tooltip = "Auto picks from the chart: up to 2H → 1H, up to 8H → 4H, up to 2D → 1D, longer → 1W. The profile sets swing spans, cooldown, context timeframes and validated thresholds.")
nearIn     = input.timeframe("", "Near context TF (blank = profile)", group = G1)
anchorIn   = input.timeframe("", "Anchor context TF (blank = profile)", group = G1)

G2 = "Thresholds"
useValidated = input.bool(true, "Use walk-forward thresholds", group = G2,
     tooltip = "Off: use the two numbers below instead. Note that custom thresholds have not been validated.")
confirmIn  = input.float(0.67, "Custom CONFIRMED score ≥", minval = 0.0, maxval = 1.0, step = 0.01, group = G2)
majorIn    = input.float(0.83, "Custom MAJOR score ≥", minval = 0.0, maxval = 1.0, step = 0.01, group = G2)
cooldownIn = input.int(0, "Same-direction cooldown, bars (0 = profile)", minval = 0, group = G2)

G3 = "Evidence"
volMode    = input.string("Auto", "Volume condition", options = ["Auto", "On", "Off"], group = G3,
     tooltip = "Auto turns volume off for forex, indices and CFDs, whose 'volume' is tick count or absent.")
adxMin     = input.float(20.0, "ADX minimum", minval = 0, group = G3)
dispAtr    = input.float(0.5, "Displacement, ATR multiple", minval = 0, step = 0.1, group = G3)
volMult    = input.float(1.3, "Volume multiple of 20-bar average", minval = 0, step = 0.1, group = G3)

G4 = "Display"
onClose    = input.bool(true, "Signals on closed candles only", group = G4,
     tooltip = "Keep on. Off shows provisional signals on the live candle; they can vanish before it closes.")
showConf   = input.bool(true, "Show CONFIRMED signals", group = G4)
showMajor  = input.bool(true, "Show MAJOR signals", group = G4)
showWarn   = input.bool(true, "Show early warnings", group = G4)
showLevels = input.bool(true, "Show active swing levels", group = G4)
showDash   = input.bool(true, "Show dashboard", group = G4)
dashPos    = input.string("Top right", "Dashboard position", options = ["Top right", "Bottom right", "Top left", "Bottom left"], group = G4)

// ── profile ──────────────────────────────────────────────────────────────────
chartSec = timeframe.in_seconds(timeframe.period)
autoProfile = chartSec <= 7200 ? "1H" : chartSec <= 28800 ? "4H" : chartSec <= 172800 ? "1D" : "1W"
profile = profileIn == "Auto" ? autoProfile : profileIn

pivL  = profile == "1W" ? 4 : 5
pivR  = profile == "1D" or profile == "1W" ? 2 : 3
coolP = profile == "1H" ? 12 : profile == "4H" ? 6 : profile == "1D" ? 5 : 4
cooldown = cooldownIn > 0 ? cooldownIn : coolP

nearP   = profile == "1H" ? "240" : profile == "4H" ? "D" : profile == "1D" ? "W" : "M"
anchorP = profile == "1H" ? "D" : profile == "4H" ? "W" : profile == "1D" ? "M" : "3M"
nearTF   = nearIn == "" ? nearP : nearIn
anchorTF = anchorIn == "" ? anchorP : anchorIn

confirmT = useValidated ? (profile == "1H" ? VAL_CONFIRM_1H : profile == "4H" ? VAL_CONFIRM_4H : profile == "1D" ? VAL_CONFIRM_1D : VAL_CONFIRM_1W) : confirmIn
majorT   = useValidated ? (profile == "1H" ? VAL_MAJOR_1H : profile == "4H" ? VAL_MAJOR_4H : profile == "1D" ? VAL_MAJOR_1D : VAL_MAJOR_1W) : majorIn
valText  = profile == "1H" ? VAL_TEXT_1H : profile == "4H" ? VAL_TEXT_4H : profile == "1D" ? VAL_TEXT_1D : VAL_TEXT_1W

volTypeOk = not (syminfo.type == "forex" or syminfo.type == "index" or syminfo.type == "cfd")
volOn = volMode == "On" or (volMode == "Auto" and volTypeOk)

// ── chart-timeframe series (identical definitions to hcmtf/ta.py) ────────────
atr  = ta.atr(14)
ema  = ta.ema(close, 21)
rsi  = ta.rsi(close, 14)
[macdLine, macdSig, hist] = ta.macd(close, 12, 26, 9)
[pdi, mdi, adx] = ta.dmi(14, 14)
rvol = volume / ta.sma(volume, 20)

// ── higher-timeframe trend, completed bars only ──────────────────────────────
htfTrend() =>
    e = ta.ema(close, 21)
    float t = na
    if not na(e[1])
        t := close > e and e > e[1] ? 1.0 : close < e and e < e[1] ? -1.0 : 0.0
    t

nearT   = request.security(syminfo.tickerid, nearTF, htfTrend()[1], lookahead = barmerge.lookahead_on)
anchorT = request.security(syminfo.tickerid, anchorTF, htfTrend()[1], lookahead = barmerge.lookahead_on)

// ── swing points, known only after pivR closed bars ──────────────────────────
leftMaxH  = ta.highest(high, pivL)[pivR + 1]
rightMaxH = ta.highest(high, pivR)
leftMinL  = ta.lowest(low, pivL)[pivR + 1]
rightMinL = ta.lowest(low, pivR)
newPH = bar_index >= pivL + pivR and high[pivR] > leftMaxH and high[pivR] >= rightMaxH
newPL = bar_index >= pivL + pivR and low[pivR] < leftMinL and low[pivR] <= rightMinL

// ── market structure ─────────────────────────────────────────────────────────
var float sh = na
var float sl = na
var int shBar = na
var int slBar = na
var bool shUsed = true
var bool slUsed = true
var int trend = 0

if newPH
    sh := high[pivR]
    shBar := bar_index - pivR
    shUsed := false
if newPL
    sl := low[pivR]
    slBar := bar_index - pivR
    slUsed := false

bool upBreak = not shUsed and close > sh
bool dnBreak = not slUsed and close < sl
if upBreak and dnBreak
    upBreak := close >= open
    dnBreak := close < open

int dir = upBreak ? 1 : dnBreak ? -1 : 0
string kind = dir != 0 and trend == -dir ? "REVERSAL" : "CONTINUATION"
float level = upBreak ? sh : sl
int levelBar = upBreak ? shBar : slBar
int prevTrend = trend
if dir != 0
    trend := dir
    if upBreak
        shUsed := true
    else
        slUsed := true

// ── evidence on the break bar ────────────────────────────────────────────────
bool cNear   = nearT == dir
bool cAnchor = anchorT == dir
bool cMom    = dir > 0 ? (rsi > 50 and hist > 0) : (rsi < 50 and hist < 0)
bool cStr    = adx >= adxMin and (dir > 0 ? pdi > mdi : mdi > pdi)
bool cDisp   = dir * (close - open) >= dispAtr * atr
bool cVol    = volOn and rvol >= volMult
float avail  = (volOn ? 6.0 : 5.0) - (na(nearT) ? 1.0 : 0.0) - (na(anchorT) ? 1.0 : 0.0)
float score  = (cNear ? 1 : 0) + (cAnchor ? 1 : 0) + (cMom ? 1 : 0) + (cStr ? 1 : 0) + (cDisp ? 1 : 0) + (cVol ? 1 : 0)
float frac   = score / avail
bool warm    = not na(atr) and not na(rsi) and not na(hist) and not na(adx)

// ── tiers and de-duplication ─────────────────────────────────────────────────
var int lastDir = 0
var int lastBar = na
var string lastText = "none yet"
var int lastSigBar = na

bool gate = onClose ? barstate.isconfirmed : true
bool isSig = false
bool isMajor = false
if dir != 0 and warm and frac >= confirmT - 1e-9 and gate
    if not (dir == lastDir and bar_index - lastBar < cooldown)
        isSig := true
        isMajor := frac >= majorT - 1e-9 and (cAnchor or na(anchorT))
        lastDir := dir
        lastBar := bar_index

// ── early warnings: momentum turns against structure, once per leg ───────────
var int leg = 0
var int armedLeg = -1
if trend != trend[1]
    leg += 1
int wDir = -trend
bool crossBack = wDir != 0 and wDir * (close - ema) > 0 and wDir * (close[1] - ema[1]) <= 0
bool isWarn = false
if trend != 0 and crossBack and wDir * (rsi - 50) > 0 and wDir * hist > 0 and armedLeg != leg and gate
    isWarn := true
    armedLeg := leg

// ── drawing ──────────────────────────────────────────────────────────────────
mark(bool c) => c ? "✓" : "·"
trendWord(float t) => na(t) ? "n/a" : t > 0 ? "up" : t < 0 ? "down" : "flat"

colBull  = color.new(#089981, 0)
colBear  = color.new(#F23645, 0)
colWarn  = color.new(#FF9800, 0)

if isSig and ((isMajor and showMajor) or (not isMajor and showConf))
    side = dir > 0 ? "BULL" : "BEAR"
    tierTxt = isMajor ? "MAJOR" : "CONFIRMED"
    codes = (cNear ? "N" : "·") + (cAnchor ? "A" : "·") + (cMom ? "M" : "·") + (cStr ? "S" : "·") + (cDisp ? "D" : "·") + (volOn ? (cVol ? "V" : "·") : "")
    txt = tierTxt + " " + side + "\n" + kind + "\n" + str.tostring(score, "#") + "/" + str.tostring(avail, "#") + " " + codes
    tip = tierTxt + " " + side + " " + kind + " — score " + str.tostring(score, "#") + "/" + str.tostring(avail, "#") + " (" + str.tostring(100 * frac, "#") + "%)" +
         "\nBroke " + (dir > 0 ? "swing high " : "swing low ") + str.tostring(level, format.mintick) + " (formed " + str.tostring(bar_index - levelBar) + " bars ago)" +
         "\nN  " + nearTF + " trend " + trendWord(nearT) + " " + mark(cNear) +
         "\nA  " + anchorTF + " trend " + trendWord(anchorT) + " " + mark(cAnchor) +
         "\nM  RSI " + str.tostring(rsi, "#.0") + ", MACD hist " + (hist > 0 ? "+" : "−") + " " + mark(cMom) +
         "\nS  ADX " + str.tostring(adx, "#.0") + ", +DI " + str.tostring(pdi, "#.0") + " / −DI " + str.tostring(mdi, "#.0") + " " + mark(cStr) +
         "\nD  body " + str.tostring(math.abs(close - open) / atr, "#.00") + " ATR " + mark(cDisp) +
         (volOn ? "\nV  volume " + str.tostring(rvol, "#.00") + "x avg " + mark(cVol) : "\nV  volume not used on this symbol") +
         "\nThresholds: confirmed ≥ " + str.tostring(confirmT, "#.00") + ", major ≥ " + str.tostring(majorT, "#.00") + " + anchor agrees" +
         "\nEvidence (" + profile + "): " + valText
    provisional = not barstate.isconfirmed
    bg = isMajor ? (dir > 0 ? colBull : colBear) : color.new(dir > 0 ? colBull : colBear, 55)
    label.new(bar_index, dir > 0 ? low : high, (provisional ? "? " : "") + txt,
         style = dir > 0 ? label.style_label_up : label.style_label_down,
         color = provisional ? color.new(bg, 85) : bg, textcolor = color.white,
         size = isMajor ? size.normal : size.small, tooltip = tip)
    lastText := tierTxt + " " + side + " " + kind + " " + str.tostring(score, "#") + "/" + str.tostring(avail, "#") + " " + codes
    lastSigBar := bar_index

if isWarn and showWarn
    label.new(bar_index, wDir > 0 ? low : high, "!",
         style = wDir > 0 ? label.style_label_up : label.style_label_down,
         color = color.new(colWarn, 30), textcolor = color.white, size = size.tiny,
         tooltip = "Early warning: possible " + (wDir > 0 ? "bullish" : "bearish") + " reversal. Price closed back across EMA(21) with RSI and MACD turning, before any structure break. Not a signal.")

plot(showLevels and not shUsed ? sh : na, "Swing high (unbroken)", color = color.new(colBear, 40), style = plot.style_linebr)
plot(showLevels and not slUsed ? sl : na, "Swing low (unbroken)", color = color.new(colBull, 40), style = plot.style_linebr)

// ── dashboard ────────────────────────────────────────────────────────────────
tfTrend(string tf) =>
    request.security(syminfo.tickerid, tf, htfTrend()[1], lookahead = barmerge.lookahead_on)

t1H = tfTrend("60")
t4H = tfTrend("240")
t1D = tfTrend("D")
t1W = tfTrend("W")

cellTrend(float t, bool lower) => lower ? "—" : na(t) ? "n/a" : t > 0 ? "▲ up" : t < 0 ? "▼ down" : "◆ flat"
cellCol(float t, bool lower) => lower or na(t) ? color.gray : t > 0 ? colBull : t < 0 ? colBear : color.gray

// "Bias" uses the trend-type conditions only (no break needed) on the last CLOSED bar.
bullNow = (nearT == 1 ? 1 : 0) + (anchorT == 1 ? 1 : 0) + (rsi > 50 and hist > 0 ? 1 : 0) + (adx >= adxMin and pdi > mdi ? 1 : 0) + (trend == 1 ? 1 : 0)
bearNow = (nearT == -1 ? 1 : 0) + (anchorT == -1 ? 1 : 0) + (rsi < 50 and hist < 0 ? 1 : 0) + (adx >= adxMin and mdi > pdi ? 1 : 0) + (trend == -1 ? 1 : 0)
bullC = barstate.isconfirmed ? bullNow : bullNow[1]
bearC = barstate.isconfirmed ? bearNow : bearNow[1]
bias = bullC >= 4 and bearC <= 1 ? "BULLISH" : bearC >= 4 and bullC <= 1 ? "BEARISH" : "NEUTRAL — evidence mixed or thin"
biasCol = bias == "BULLISH" ? colBull : bias == "BEARISH" ? colBear : color.gray

pos = dashPos == "Top right" ? position.top_right : dashPos == "Bottom right" ? position.bottom_right : dashPos == "Top left" ? position.top_left : position.bottom_left
var table dash = table.new(pos, 2, 10, bgcolor = color.new(#131722, 10), border_color = color.new(color.gray, 70), border_width = 1)

if showDash and barstate.islast
    tc = color.new(color.white, 0)
    table.cell(dash, 0, 0, "HC-MTF · " + profile + " profile", text_color = tc, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 0, "N " + nearTF + " · A " + anchorTF, text_color = color.gray, text_size = size.small, text_halign = text.align_right)
    table.cell(dash, 0, 1, "1H", text_color = color.gray, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 1, cellTrend(t1H, chartSec > 3600), text_color = cellCol(t1H, chartSec > 3600), text_size = size.small, text_halign = text.align_right)
    table.cell(dash, 0, 2, "4H", text_color = color.gray, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 2, cellTrend(t4H, chartSec > 14400), text_color = cellCol(t4H, chartSec > 14400), text_size = size.small, text_halign = text.align_right)
    table.cell(dash, 0, 3, "1D", text_color = color.gray, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 3, cellTrend(t1D, chartSec > 86400), text_color = cellCol(t1D, chartSec > 86400), text_size = size.small, text_halign = text.align_right)
    table.cell(dash, 0, 4, "1W", text_color = color.gray, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 4, cellTrend(t1W, chartSec > 604800), text_color = cellCol(t1W, chartSec > 604800), text_size = size.small, text_halign = text.align_right)
    table.cell(dash, 0, 5, "Structure", text_color = color.gray, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 5, trend > 0 ? "bullish" : trend < 0 ? "bearish" : "undefined", text_color = trend > 0 ? colBull : trend < 0 ? colBear : color.gray, text_size = size.small, text_halign = text.align_right)
    table.cell(dash, 0, 6, "Bias (bull/bear of 5)", text_color = color.gray, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 6, bias + "  " + str.tostring(bullC) + "/" + str.tostring(bearC), text_color = biasCol, text_size = size.small, text_halign = text.align_right)
    table.cell(dash, 0, 7, "Last signal", text_color = color.gray, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 7, lastText + (na(lastSigBar) ? "" : "  (" + str.tostring(bar_index - lastSigBar) + " bars ago)"), text_color = tc, text_size = size.small, text_halign = text.align_right)
    table.cell(dash, 0, 8, "Thresholds", text_color = color.gray, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 8, "confirmed ≥ " + str.tostring(confirmT, "#.00") + " · major ≥ " + str.tostring(majorT, "#.00") + (useValidated ? "" : " (custom, unvalidated)"), text_color = tc, text_size = size.small, text_halign = text.align_right)
    table.cell(dash, 0, 9, "Out-of-sample evidence", text_color = color.gray, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, 9, valText, text_color = tc, text_size = size.small, text_halign = text.align_right)

// ── alerts (fire once, on the closed candle) ─────────────────────────────────
alertcondition(isSig and isMajor and dir > 0, "MAJOR bullish", "HC-MTF MAJOR bullish on {{ticker}} {{interval}} at {{close}}")
alertcondition(isSig and isMajor and dir < 0, "MAJOR bearish", "HC-MTF MAJOR bearish on {{ticker}} {{interval}} at {{close}}")
alertcondition(isSig and not isMajor and dir > 0, "CONFIRMED bullish", "HC-MTF confirmed bullish on {{ticker}} {{interval}} at {{close}}")
alertcondition(isSig and not isMajor and dir < 0, "CONFIRMED bearish", "HC-MTF confirmed bearish on {{ticker}} {{interval}} at {{close}}")
alertcondition(isWarn, "Early warning", "HC-MTF early reversal warning on {{ticker}} {{interval}}")
if isSig
    alert('{"ticker":"' + syminfo.tickerid + '","tf":"' + timeframe.period + '","tier":"' + (isMajor ? "major" : "confirmed") + '","dir":' + str.tostring(dir) + ',"kind":"' + kind + '","score":' + str.tostring(score) + ',"available":' + str.tostring(avail) + ',"close":' + str.tostring(close) + '}', alert.freq_once_per_bar_close)
