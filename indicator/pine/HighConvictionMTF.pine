//@version=6
indicator("High-Conviction MTF Trend Signals", shorttitle = "HC-MTF", overlay = true, max_labels_count = 500)

// ─────────────────────────────────────────────────────────────────────────────
// HC-MTF v2 — LTF / MTF / HTF ladder. Research twin: hcmtf/engine.py (same rules).
//
//   The chart timeframe is the MTF: structure breaks are found and signals print here.
//   HTF1 + HTF2 set direction and decide how much a break matters.
//   The LTF (candles inside each closed chart candle) gives early warnings.
//
//     chart  LTF   HTF1  HTF2          Every structure break is one of:
//     1H     15m   4H    1D              REALIGNMENT   MTF turns back into the HTF direction → MAJOR
//     4H     1H    1D    1W              CONTINUATION  break with MTF structure and HTFs   → CONFIRMED
//     1D     4H    1W    1M              COUNTER-HTF   MTF turns against the HTFs: possible
//     1W     1D    1M    3M                REVERSAL    HTF reversal developing           → WATCH (not a signal)
//                                        anything else (HTFs flat, counter-HTF continuation) → neutral
//
//   "With the HTFs" = HTF1 + HTF2 >= 1 in the break direction and neither against it.
//   Momentum, strength, displacement, FVG, volume, sweeps and LTF momentum are shown in the
//   tooltip as context. They do NOT gate signals: none of them improved outcomes in the
//   pre-registered screening (reports/SCREENING.md). Gating on them would make signals
//   rarer without making them better. The evidence count is not a probability.
//   Each profile's out-of-sample record is in the dashboard and label tooltip.
//
// Integrity: closed candles only (default); HTF via f()[1] + lookahead_on (previous
// completed HTF candle); LTF via request.security_lower_tf read on the closed chart
// candle; swing points used only after their right-hand candles close.
// ─────────────────────────────────────────────────────────────────────────────

// <<VALIDATED (generated by scripts/sync_pine.py — do not edit by hand)
VAL_CONFIRM_1H = 0.0
VAL_MAJOR_1H   = 0.0
VAL_CONFIRM_4H = 0.0
VAL_MAJOR_4H   = 0.0
VAL_CONFIRM_1D = 0.0
VAL_MAJOR_1D   = 0.0
VAL_CONFIRM_1W = 0.0
VAL_MAJOR_1W   = 0.0
USE_MOMENTUM = false
USE_STRENGTH = false
USE_DISPLACEMENT = false
USE_FVG = false
USE_VOLUME = false
USE_SWEEP = false
USE_LTF = false
FLT_RANGE = false
FLT_SHOCK = false
FLT_SPIKE = false
FLT_WEEKEND = false
CRYPTO_ONLY = "||"
VAL_TEXT_1H_C = "MAJOR PROMISING on unseen crypto symbols: n=6887, +0.07 ATR vs -0.18 random (95% CI -0.08..+0.22)"
VAL_TEXT_1H_O = "MAJOR UNPROVEN on unseen non-crypto symbols: n=1153, -0.30 ATR vs -0.12 random (95% CI -0.55..-0.05)"
VAL_TEXT_4H_C = "MAJOR PROMISING on unseen crypto symbols: n=1829, +0.43 ATR vs -0.11 random (95% CI +0.04..+0.85)"
VAL_TEXT_4H_O = "MAJOR UNPROVEN on unseen non-crypto symbols: n=300, -0.24 ATR vs +0.23 random (95% CI -0.86..+0.33)"
VAL_TEXT_1D_C = "MAJOR UNPROVEN on unseen crypto symbols: n=392, -0.12 ATR vs -0.18 random (95% CI -0.73..+0.43)"
VAL_TEXT_1D_O = "MAJOR UNPROVEN on unseen non-crypto symbols: n=898, +0.10 ATR vs +0.20 random (95% CI -0.15..+0.35)"
VAL_TEXT_1W_C = "MAJOR UNPROVEN on unseen crypto symbols: n=46, -0.33 ATR vs -0.76 random (95% CI -2.73..+1.55)"
VAL_TEXT_1W_O = "MAJOR UNPROVEN on unseen non-crypto symbols: n=216, +0.40 ATR vs +0.44 random (95% CI -0.02..+0.75)"
// VALIDATED>>

// ── inputs ───────────────────────────────────────────────────────────────────
G1 = "Timeframe ladder"
profileIn = input.string("Auto", "Profile", options = ["Auto", "1H", "4H", "1D", "1W"], group = G1,
     tooltip = "Auto: chart up to 2H → 1H, up to 8H → 4H, up to 2D → 1D, longer → 1W. Sets the ladder, swing spans, cooldown and validated thresholds.")
ltfIn  = input.timeframe("", "LTF (blank = profile)", group = G1)
htf1In = input.timeframe("", "HTF1 (blank = profile)", group = G1)
htf2In = input.timeframe("", "HTF2 (blank = profile)", group = G1)

G2 = "Thresholds and components"
useValidated = input.bool(true, "Use the tested configuration", group = G2,
     tooltip = "On: evidence conditions are shown but do not gate signals (screening kept none). Off: the conditions ticked below gate signals at the thresholds below. That has NOT been validated; the dashboard says so.")
confirmIn = input.float(0.6, "Research: CONFIRMED evidence ≥", minval = 0, maxval = 1, step = 0.05, group = G2)
majorIn   = input.float(0.8, "Research: MAJOR evidence ≥", minval = 0, maxval = 1, step = 0.05, group = G2)
cMomIn  = input.bool(true, "Momentum (RSI/MACD)", group = G2, inline = "c1")
cStrIn  = input.bool(true, "Strength (ADX/DI)", group = G2, inline = "c1")
cDispIn = input.bool(true, "Displacement", group = G2, inline = "c2")
cFvgIn  = input.bool(false, "Fair-value gap", group = G2, inline = "c2")
cVolIn  = input.bool(true, "Volume", group = G2, inline = "c3")
cSwpIn  = input.bool(false, "Liquidity sweep", group = G2, inline = "c3")
cLtfIn  = input.bool(false, "LTF momentum", group = G2, inline = "c4")
fRngIn  = input.bool(false, "Filter: range (ADX<18)", group = G2, inline = "f1")
fShkIn  = input.bool(false, "Filter: volatility shock", group = G2, inline = "f1")
fSpkIn  = input.bool(false, "Filter: spike/liquidation wick", group = G2, inline = "f2")
fWkdIn  = input.bool(false, "Filter: crypto weekend", group = G2, inline = "f2")
cooldownIn = input.int(0, "Same-direction cooldown, candles (0 = profile)", minval = 0, group = G2)

G3 = "Market"
volMode = input.string("Auto", "Volume", options = ["Auto", "On", "Off"], group = G3,
     tooltip = "Auto: off for forex, indices and CFDs (tick or no volume), on elsewhere. Exchange-specific crypto volume is used as reported.")

G4 = "Display"
onClose   = input.bool(true, "Signals on closed candles only", group = G4)
showCont  = input.bool(false, "Also mark continuation breaks", group = G4,
     tooltip = "Off (default): arrows mark the high-conviction signals only (structure turning back into the higher-timeframe direction). On: further breaks in the HTF direction are marked too, with the same BULLISH/BEARISH arrows.")
arrowSize = input.string("Normal", "Arrow size", options = ["Small", "Normal", "Large"], group = G4)
textStyle = input.string("Chart text colour", "Label text", options = ["Chart text colour", "Same as arrow"], group = G4,
     tooltip = "Chart text colour keeps BULLISH/BEARISH readable on light and dark themes, with the arrow carrying the colour.")
showLvls  = input.bool(true, "Show unbroken swing levels", group = G4)
showDash  = input.bool(true, "Show dashboard", group = G4)
parity    = input.bool(false, "Parity export (plots codes for scripts/compare_tv_export.py)", group = G4)

// ── profile and ladder ───────────────────────────────────────────────────────
chartSec = timeframe.in_seconds(timeframe.period)
profile = profileIn != "Auto" ? profileIn : chartSec <= 7200 ? "1H" : chartSec <= 28800 ? "4H" : chartSec <= 172800 ? "1D" : "1W"
ltfP  = profile == "1H" ? "15" : profile == "4H" ? "60" : profile == "1D" ? "240" : "D"
htf1P = profile == "1H" ? "240" : profile == "4H" ? "D" : profile == "1D" ? "W" : "M"
htf2P = profile == "1H" ? "D" : profile == "4H" ? "W" : profile == "1D" ? "M" : "3M"
ltfReq = ltfIn == "" ? ltfP : ltfIn
ltfTF  = timeframe.in_seconds(ltfReq) <= chartSec ? ltfReq : timeframe.period
htf1TF = htf1In == "" ? htf1P : htf1In
htf2TF = htf2In == "" ? htf2P : htf2In

pivL = profile == "1W" ? 4 : 5
pivR = profile == "1D" or profile == "1W" ? 2 : 3
cooldown = cooldownIn > 0 ? cooldownIn : profile == "1H" ? 12 : profile == "4H" ? 6 : profile == "1D" ? 5 : 4

pick(a1, a4, ad, aw) => profile == "1H" ? a1 : profile == "4H" ? a4 : profile == "1D" ? ad : aw
confirmT = useValidated ? pick(VAL_CONFIRM_1H, VAL_CONFIRM_4H, VAL_CONFIRM_1D, VAL_CONFIRM_1W) : confirmIn
majorT   = useValidated ? pick(VAL_MAJOR_1H, VAL_MAJOR_4H, VAL_MAJOR_1D, VAL_MAJOR_1W) : majorIn

isCrypto = syminfo.type == "crypto"
valText = isCrypto ? pick(VAL_TEXT_1H_C, VAL_TEXT_4H_C, VAL_TEXT_1D_C, VAL_TEXT_1W_C) : pick(VAL_TEXT_1H_O, VAL_TEXT_4H_O, VAL_TEXT_1D_O, VAL_TEXT_1W_O)
// items listed in CRYPTO_ONLY were kept by screening for crypto only; elsewhere they are off
ok(string name, bool use) => use and (isCrypto or not str.contains(CRYPTO_ONLY, "|" + name + "|"))
uMom  = useValidated ? ok("momentum", USE_MOMENTUM) : cMomIn
uStr  = useValidated ? ok("strength", USE_STRENGTH) : cStrIn
uDisp = useValidated ? ok("displacement", USE_DISPLACEMENT) : cDispIn
uFvg  = useValidated ? ok("fvg", USE_FVG) : cFvgIn
uVol  = useValidated ? ok("volume", USE_VOLUME) : cVolIn
uSwp  = useValidated ? ok("sweep", USE_SWEEP) : cSwpIn
uLtf  = useValidated ? ok("ltf_momentum", USE_LTF) : cLtfIn
fRng  = useValidated ? ok("not_range", FLT_RANGE) : fRngIn
fShk  = useValidated ? ok("not_shock", FLT_SHOCK) : fShkIn
fSpk  = useValidated ? ok("not_spike_wick", FLT_SPIKE) : fSpkIn
fWkd  = useValidated ? ok("not_weekend", FLT_WEEKEND) : fWkdIn

volOn = volMode == "On" or (volMode == "Auto" and not (syminfo.type == "forex" or syminfo.type == "index" or syminfo.type == "cfd"))

// ── chart (MTF) series, same definitions as hcmtf/ta.py ──────────────────────
atr  = ta.atr(14)
ema  = ta.ema(close, 21)
rsi  = ta.rsi(close, 14)
[macdL, macdS, hist] = ta.macd(close, 12, 26, 9)
[pdi, mdi, adx] = ta.dmi(14, 14)
rvol = volume / ta.sma(volume, 20)
volRank = ta.percentrank(atr / close, 200)

// ── HTF trend from completed HTF candles ─────────────────────────────────────
htfTrend() =>
    e = ta.ema(close, 21)
    float t = na
    if not na(e[1])
        t := close > e and e > e[1] ? 1.0 : close < e and e < e[1] ? -1.0 : 0.0
    t
t1 = request.security(syminfo.tickerid, htf1TF, htfTrend()[1], lookahead = barmerge.lookahead_on)
t2 = request.security(syminfo.tickerid, htf2TF, htfTrend()[1], lookahead = barmerge.lookahead_on)

// ── LTF: momentum and structure on the last LTF candle inside this chart candle ──
momState() =>
    r = ta.rsi(close, 14)
    [_m, _s, hh] = ta.macd(close, 12, 26, 9)
    float s = na
    if not na(r) and not na(hh)
        s := r > 50 and hh > 0 ? 1.0 : r < 50 and hh < 0 ? -1.0 : 0.0
    s

structState(int L, int R) =>
    var float sh = na
    var float sl = na
    var bool shU = true
    var bool slU = true
    var float tr = 0.0
    lmH = ta.highest(high, L)[R + 1]
    rmH = ta.highest(high, R)
    lmL = ta.lowest(low, L)[R + 1]
    rmL = ta.lowest(low, R)
    if bar_index >= L + R and high[R] > lmH and high[R] >= rmH
        sh := high[R]
        shU := false
    if bar_index >= L + R and low[R] < lmL and low[R] <= rmL
        sl := low[R]
        slU := false
    up = not shU and close > sh
    dn = not slU and close < sl
    if up and dn
        up := close >= open
        dn := close < open
    if up
        tr := 1.0
        shU := true
    else if dn
        tr := -1.0
        slU := true
    tr

[ltfMomArr, ltfStrArr] = request.security_lower_tf(syminfo.tickerid, ltfTF, [momState(), structState(5, 3)])
float ltfMom = array.size(ltfMomArr) > 0 ? array.last(ltfMomArr) : na
float ltfStr = array.size(ltfStrArr) > 0 ? array.last(ltfStrArr) : na

// ── MTF structure, sweeps ────────────────────────────────────────────────────
lmH = ta.highest(high, pivL)[pivR + 1]
rmH = ta.highest(high, pivR)
lmL = ta.lowest(low, pivL)[pivR + 1]
rmL = ta.lowest(low, pivR)
newPH = bar_index >= pivL + pivR and high[pivR] > lmH and high[pivR] >= rmH
newPL = bar_index >= pivL + pivR and low[pivR] < lmL and low[pivR] <= rmL

var float sh = na
var float sl = na
var bool shUsed = true
var bool slUsed = true
var int trend = 0
if newPH
    sh := high[pivR]
    shUsed := false
if newPL
    sl := low[pivR]
    slUsed := false

bool sweepUp = not na(sl) and low < sl and close > sl
bool sweepDn = not na(sh) and high > sh and close < sh
bool upBreak = not shUsed and close > sh
bool dnBreak = not slUsed and close < sl
if upBreak and dnBreak
    upBreak := close >= open
    dnBreak := close < open
int dir = upBreak ? 1 : dnBreak ? -1 : 0
float level = upBreak ? sh : sl
bool choch = dir != 0 and trend == -dir
if dir != 0
    trend := dir
    if upBreak
        shUsed := true
    else
        slUsed := true

// ── class ────────────────────────────────────────────────────────────────────
float a1 = na(t1) ? 0.0 : t1 * dir
float a2 = na(t2) ? 0.0 : t2 * dir
bool against = a1 < 0 or a2 < 0
bool htfWith = a1 + a2 >= 1 and not against
string cls = against ? (choch ? "COUNTER-HTF REVERSAL" : "counter") : (choch ? "REALIGNMENT" : "CONTINUATION")

// ── evidence (families count once) ───────────────────────────────────────────
bool eMom  = dir > 0 ? (rsi > 50 and hist > 0) : (rsi < 50 and hist < 0)
bool eStr  = adx >= 20 and (dir > 0 ? pdi > mdi : mdi > pdi)
bool eDisp = dir * (close - open) >= 0.5 * atr
bool eFvg  = dir > 0 ? (low > high[2] or low[1] > high[3]) : (high < low[2] or high[1] < low[3])
bool eVol  = volOn and rvol >= 1.3
bool eSwp  = dir > 0 ? math.sum(sweepUp ? 1 : 0, 11) > 0 : math.sum(sweepDn ? 1 : 0, 11) > 0
bool eLtf  = ltfMom == dir

float met = 0.0
float avail = 0.0
if uMom
    avail += 1
    met += eMom ? 1 : 0
if uStr
    avail += 1
    met += eStr ? 1 : 0
if uDisp or uFvg
    avail += 1
    met += (uDisp and eDisp) or (uFvg and eFvg) ? 1 : 0
if uVol and volOn
    avail += 1
    met += eVol ? 1 : 0
if uSwp
    avail += 1
    met += eSwp ? 1 : 0
if uLtf and not na(ltfMom)
    avail += 1
    met += eLtf ? 1 : 0
float frac = avail > 0 ? met / avail : 0.0

// filters
oppWick = dir > 0 ? high - math.max(open, close) : math.min(open, close) - low
bool spike = oppWick > 0.8 * atr and high - low > 0 and (not volOn or rvol >= 1.2)
bool weekend = isCrypto and (dayofweek == dayofweek.saturday or dayofweek == dayofweek.sunday)
bool passes = not (fRng and adx < 18) and not (fShk and volRank >= 95) and not (fSpk and spike) and not (fWkd and weekend)
bool warm = not na(atr) and not na(rsi) and not na(hist) and not na(adx)

// ── tiers and cooldown ───────────────────────────────────────────────────────
var int lastDir = 0
var int lastBar = na
var string lastText = "none yet"
var int lastSigBar = na
bool gate = onClose ? barstate.isconfirmed : true
bool isSig = false
bool isMajor = false
bool isWatch = dir != 0 and warm and passes and gate and cls == "COUNTER-HTF REVERSAL"
if dir != 0 and warm and passes and gate and (cls == "REALIGNMENT" or cls == "CONTINUATION") and htfWith and frac >= confirmT - 1e-9
    if not (dir == lastDir and bar_index - lastBar < cooldown)
        isSig := true
        isMajor := cls == "REALIGNMENT" and frac >= majorT - 1e-9
        lastDir := dir
        lastBar := bar_index

// ── early warnings: LTF structure turns against MTF structure (fallback: MTF momentum) ──
var int leg = 0
var int armed = -1
if trend != trend[1]
    leg += 1
int wDir = -trend
bool wFire = false
if not na(ltfStr)
    wFire := ltfStr == wDir and not (ltfStr[1] == wDir)
else
    wFire := wDir * (close - ema) > 0 and wDir * (close[1] - ema[1]) <= 0 and wDir * (rsi - 50) > 0 and wDir * hist > 0
bool isWarn = false
if trend != 0 and wFire and armed != leg and gate
    isWarn := true
    armed := leg

// ── drawing: two signal types only, BULLISH ▲ and BEARISH ▼ ─────────────────
colBull = #089981
colBear = #F23645
colWarn = #FF9800
tw(float t) => na(t) ? "n/a" : t > 0 ? "up" : t < 0 ? "down" : "flat"

// The signal itself is unchanged; this only decides which signals get an arrow.
bool showSig = isSig and (isMajor or showCont)
bool bullSig = showSig and dir > 0
bool bearSig = showSig and dir < 0
lblSize = arrowSize == "Small" ? size.small : arrowSize == "Large" ? size.large : size.normal

if showSig
    side = dir > 0 ? "BULLISH" : "BEARISH"
    tip = side + " — " + (cls == "REALIGNMENT" ? "the " + timeframe.period + " structure turned back into the higher-timeframe direction" : "the " + timeframe.period + " structure broke again in the higher-timeframe direction") +
         "\nBroke " + (dir > 0 ? "swing high " : "swing low ") + str.tostring(level, format.mintick) +
         "\nHTF1 " + htf1TF + ": " + tw(t1) + " · HTF2 " + htf2TF + ": " + tw(t2) +
         "\nLTF " + ltfTF + ": momentum " + tw(ltfMom) + ", structure " + tw(ltfStr) +
         "\nRecord (" + profile + "): " + valText
    prov = not barstate.isconfirmed
    c = dir > 0 ? colBull : colBear
    // Arrow styles draw the arrow at the candle's low/high with the text on the far side,
    // and yloc above/below bar keeps both clear of the wick.
    label.new(bar_index, dir > 0 ? low : high, (prov ? "? " : "") + side, xloc = xloc.bar_index,
         yloc = dir > 0 ? yloc.belowbar : yloc.abovebar,
         style = dir > 0 ? label.style_arrowup : label.style_arrowdown,
         color = prov ? color.new(c, 60) : c, textcolor = color.new(textStyle == "Same as arrow" ? c : chart.fg_color, prov ? 50 : 0),
         size = lblSize, text_formatting = text.format_bold, tooltip = tip)
    lastText := side
    lastSigBar := bar_index

plot(showLvls and not shUsed ? sh : na, "Unbroken swing high", color = color.new(colBear, 40), style = plot.style_linebr)
plot(showLvls and not slUsed ? sl : na, "Unbroken swing low", color = color.new(colBull, 40), style = plot.style_linebr)

// parity export: one number per candle per item, readable from "Export chart data"
plot(parity ? (isSig ? dir * (isMajor ? 2 : 1) : 0) : na, "parity_signal", display = display.data_window)
plot(parity ? (isWarn ? wDir : 0) : na, "parity_warning", display = display.data_window)
plot(parity ? (isWatch ? dir : 0) : na, "parity_watch", display = display.data_window)
plot(parity ? met : na, "parity_met", display = display.data_window)
plot(parity ? t1 : na, "parity_htf1", display = display.data_window)
plot(parity ? t2 : na, "parity_htf2", display = display.data_window)
plot(parity ? ltfMom : na, "parity_ltf_mom", display = display.data_window)
plot(parity ? ltfStr : na, "parity_ltf_struct", display = display.data_window)

// ── dashboard ────────────────────────────────────────────────────────────────
trendAt(string tf) => request.security(syminfo.tickerid, tf, htfTrend()[1], lookahead = barmerge.lookahead_on)
tH1 = trendAt("60")
tH4 = trendAt("240")
tD  = trendAt("D")
tW  = trendAt("W")
cellT(float t, bool lower) => lower ? "—" : na(t) ? "n/a" : t > 0 ? "▲ up" : t < 0 ? "▼ down" : "◆ flat"
cellC(float t, bool lower) => lower or na(t) ? color.gray : t > 0 ? colBull : t < 0 ? colBear : color.gray

bullN = (t1 == 1 ? 1 : 0) + (t2 == 1 ? 1 : 0) + (trend == 1 ? 1 : 0) + (rsi > 50 and hist > 0 ? 1 : 0)
bearN = (t1 == -1 ? 1 : 0) + (t2 == -1 ? 1 : 0) + (trend == -1 ? 1 : 0) + (rsi < 50 and hist < 0 ? 1 : 0)
bullC = barstate.isconfirmed ? bullN : bullN[1]
bearC = barstate.isconfirmed ? bearN : bearN[1]
alignTxt = bullC == 4 ? "ALIGNED BULLISH" : bearC == 4 ? "ALIGNED BEARISH" : (t1 == 1 or t2 == 1) and (t1 == -1 or t2 == -1) ? "HTF CONFLICT — neutral" : "NEUTRAL / mixed"
alignC = bullC == 4 ? colBull : bearC == 4 ? colBear : color.gray

var table dash = table.new(position.top_right, 2, 11, bgcolor = color.new(#131722, 10), border_color = color.new(color.gray, 70), border_width = 1)
row(int r, string k, string v, color c) =>
    table.cell(dash, 0, r, k, text_color = color.gray, text_size = size.small, text_halign = text.align_left)
    table.cell(dash, 1, r, v, text_color = c, text_size = size.small, text_halign = text.align_right)
if showDash and barstate.islast
    row(0, "HC-MTF · " + profile, "LTF " + ltfTF + " · HTF " + htf1TF + "/" + htf2TF, color.white)
    row(1, "1H", cellT(tH1, chartSec > 3600), cellC(tH1, chartSec > 3600))
    row(2, "4H", cellT(tH4, chartSec > 14400), cellC(tH4, chartSec > 14400))
    row(3, "1D", cellT(tD, chartSec > 86400), cellC(tD, chartSec > 86400))
    row(4, "1W", cellT(tW, chartSec > 604800), cellC(tW, chartSec > 604800))
    row(5, "LTF " + ltfTF, "momentum " + tw(ltfMom) + " · structure " + tw(ltfStr), color.white)
    row(6, "MTF structure", trend > 0 ? "bullish" : trend < 0 ? "bearish" : "undefined", trend > 0 ? colBull : trend < 0 ? colBear : color.gray)
    row(7, "Alignment", alignTxt, alignC)
    row(8, "Last signal", (lastText == "BULLISH" ? "▲ " : lastText == "BEARISH" ? "▼ " : "") + lastText + (na(lastSigBar) ? "" : " (" + str.tostring(bar_index - lastSigBar) + " ago)"), lastText == "BULLISH" ? colBull : lastText == "BEARISH" ? colBear : color.white)
    row(9, "Configuration", useValidated ? "tested (HTF-gated, no evidence gate)" : "CUSTOM evidence gate — unvalidated", useValidated ? color.white : colWarn)
    row(10, "Out-of-sample record", valText, color.white)

// ── alerts: the same two signal types ────────────────────────────────────────
alertcondition(bullSig, "BULLISH", "HC-MTF BULLISH ▲ {{ticker}} {{interval}} {{close}}")
alertcondition(bearSig, "BEARISH", "HC-MTF BEARISH ▼ {{ticker}} {{interval}} {{close}}")
if showSig
